{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cuse-pi-durable-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "durable_objects": {
    "bindings": [{ "name": "RESOURCES", "class_name": "PiResource" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PiResource"] }],
  "observability": { "enabled": false },
}
