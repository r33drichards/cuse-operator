{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "architectures.cuse.io"
  },
  "spec": {
    "group": "cuse.io",
    "scope": "Namespaced",
    "names": {
      "plural": "architectures",
      "singular": "architecture",
      "kind": "Architecture"
    },
    "versions": [
      {
        "name": "v1alpha1",
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        },
        "additionalPrinterColumns": [
          {
            "name": "Validation",
            "type": "string",
            "jsonPath": ".status.phase"
          },
          {
            "name": "Observed",
            "type": "integer",
            "jsonPath": ".status.observedGeneration"
          }
        ],
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "properties": {
              "apiVersion": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "metadata": {
                "type": "object"
              },
              "spec": {
                "type": "object",
                "properties": {
                  "irc": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "endpoint": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "endpoint"
                    ]
                  },
                  "bots": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "weechat": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "server_id": {
                              "type": "string"
                            },
                            "nick": {
                              "type": "string"
                            },
                            "mcp_endpoint": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "server_id",
                            "nick",
                            "mcp_endpoint"
                          ]
                        },
                        "harness": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "user_id": {
                              "type": "string"
                            },
                            "weechat_id": {
                              "type": "string"
                            },
                            "sessions": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string"
                                  },
                                  "harness_id": {
                                    "type": "string"
                                  },
                                  "channel": {
                                    "type": "object",
                                    "properties": {
                                      "server_id": {
                                        "type": "string"
                                      },
                                      "name": {
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "server_id",
                                      "name"
                                    ]
                                  },
                                  "context_ref": {
                                    "type": "string"
                                  },
                                  "share_url": {
                                    "type": "string"
                                  },
                                  "mcp": {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "string"
                                      },
                                      "endpoint": {
                                        "type": "string"
                                      },
                                      "connectors": {
                                        "type": "array",
                                        "items": {
                                          "type": "object",
                                          "properties": {
                                            "id": {
                                              "type": "string"
                                            },
                                            "server_id": {
                                              "type": "string"
                                            },
                                            "nick": {
                                              "type": "string"
                                            },
                                            "mcp_endpoint": {
                                              "type": "string"
                                            }
                                          },
                                          "required": [
                                            "id",
                                            "server_id",
                                            "nick",
                                            "mcp_endpoint"
                                          ]
                                        },
                                        "default": []
                                      }
                                    },
                                    "required": [
                                      "id",
                                      "endpoint"
                                    ]
                                  }
                                },
                                "required": [
                                  "id",
                                  "harness_id",
                                  "channel",
                                  "context_ref",
                                  "share_url",
                                  "mcp"
                                ]
                              },
                              "default": []
                            }
                          },
                          "required": [
                            "id",
                            "user_id",
                            "weechat_id"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "weechat",
                        "harness"
                      ]
                    },
                    "default": []
                  }
                },
                "required": [
                  "irc"
                ]
              },
              "status": {
                "type": "object",
                "properties": {
                  "phase": {
                    "type": "string",
                    "enum": [
                      "Valid",
                      "Invalid"
                    ]
                  },
                  "observedGeneration": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "Validated",
                      "ValidationFailed",
                      "Retained"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "ready": {
                    "type": "boolean"
                  },
                  "reconciliationReason": {
                    "type": "string"
                  },
                  "desiredRevision": {
                    "type": "string"
                  },
                  "observedRevision": {
                    "type": "string"
                  },
                  "lastAction": {
                    "type": "string",
                    "enum": [
                      "None",
                      "Create",
                      "Update",
                      "NoOp",
                      "Retain"
                    ]
                  }
                },
                "required": [
                  "phase",
                  "observedGeneration",
                  "reason",
                  "message"
                ]
              }
            },
            "required": [
              "spec"
            ]
          }
        }
      }
    ]
  }
}
